# Servidor
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autotools

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Email (Nodemailer con Gmail)
EMAIL_USER=
EMAIL_PASS=

# Web Push (VAPID) — generá las keys con: node -e "const wp = require('web-push'); console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:tu@email.com

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173
